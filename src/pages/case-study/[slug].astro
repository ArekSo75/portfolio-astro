---
// SZABLON case study. Jedno miejsce dla układu WSZYSTKICH case studies.
// Treść każdego case = osobny plik w src/data/cases/ (rejestr: cases/index.js).
// Zmiana tutaj (hero, odstępy, układ sekcji) wchodzi do wszystkich case studies naraz.
//
// Hero używa tego samego markupu .hero-text h1 co HP/About → animacja maski (main.js)
// działa bez zmian. <span class="hl-mute"> = szary fragment, <br> = wymuszone złamanie.
//
// Każda sekcja (Section, line=false, reveal=false) opisuje TEKSTEM obrazek leżący POD nią
// (slot "fig", pełna szerokość). Obrazki: 16px odstęp; { join:true } = sklejone (0px, klasa fig-join).
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import CasePanel from '../../components/CasePanel.astro';
import Tile from '../../components/Tile.astro';
import { cases } from '../../data/cases/index.js';
import { work } from '../../data/work.js';

export function getStaticPaths() {
  return cases.map((c) => ({ params: { slug: c.slug }, props: { data: c } }));
}

const { data } = Astro.props;
const base = `/assets/work/${data.slug}`;

// NEXT PROJECTS: kolejne 2 case studies z siatki HP, po kole (kolejność jak w work.js).
// Tylko wewnętrzne case'y (bez Behance i "Soon..."); nowy case w work.js wchodzi tu sam.
// wide zdjęte: w siatce 2 kafelków Apaczka renderuje się jak zwykły kafel (nie na całą szerokość).
// Obiekt kafla wide jest kadrowany pod szeroki box (90%), w wąskim gubi skalę → powiększony do 115%.
// Różne wysokości jak na HP: lewy kafel kwadrat (1/1, wyższy), prawy prostokąt (domyślne 1/0.86, niższy).
// Na mobile bez znaczenia (globalna reguła i tak robi wszystkie kwadratowe).
const caseTiles = work.filter((w) => w.href && !w.external);
const currentIdx = caseTiles.findIndex((w) => w.href === `/case-study/${data.slug}`);
const nextTiles = [1, 2].map((n) => {
  const t = caseTiles[(currentIdx + n) % caseTiles.length];
  return {
    ...t,
    wide: false,
    media: {
      ...t.media,
      ...(t.wide && { shotW: '115%' }),
      ...(n === 1 && { ar: '1 / 1' }),
    },
  };
});

// Nagłówek hero: linie łamane <br>, fragmenty mute w <span class="hl-mute"> (jak oryginał).
const titleHtml = data.hero.title
  .map((p) => (p.mute ? `<span class="hl-mute">${p.text}</span>` : p.text))
  .join('<br>');

// Hero cover na tle (coverBg): opcjonalnie węższy obrazek (coverWidth, domyślnie 80%)
// i górny limit szerokości (coverMaxWidth).
const coverStyle = data.hero.coverBg
  ? [
      `background:${data.hero.coverBg}`,
      data.hero.coverWidth && `--cover-w:${data.hero.coverWidth}`,
      data.hero.coverMaxWidth && `--cover-maxw:${data.hero.coverMaxWidth}`,
    ].filter(Boolean).join(';')
  : undefined;
---

<Layout
  title={`${data.title} – Case study – Arek Sobczyk`}
  description={data.description}
>
  <!-- TOP ZONE: hero case study. Nagłówek na górze, meta na dole. -->
  <div class="topzone case-top">
    <section class="case-hero">
      <div class="hero-text">
        <h1 set:html={titleHtml}></h1>
      </div>

      <div class="case-meta">
        <p class={`case-intro t-display-40${data.hero.introNoWrap ? ' case-intro--nowrap' : ''}`} style={data.hero.introWidth ? `--intro-w:${data.hero.introWidth}` : undefined}>{data.hero.intro}</p>
        <span class="case-role t-body-20">{data.hero.role}</span>
        <span class="case-year t-body-20">({data.hero.year})</span>
      </div>
    </section>
  </div><!-- /topzone -->

  <!-- HERO IMAGE (pełna szerokość, pod hero). Widoczny od startu.
       coverBg = obrazek wyśrodkowany na kolorowym tle (80% desktop / 100% mobile), jak panele. -->
  <div class={`case-cover${data.hero.coverBg ? ' case-cover--panel' : ''}`} style={coverStyle}>
    <img src={`${base}/case/${data.hero.cover}`} alt={data.title} />
  </div>

  {data.sections.map((s) => (
    <Section label={s.label} line={false} reveal={false} last={s.last} figLg={s.figLg} textOnly={s.last && !s.figures && !s.video && !s.band}>
      {s.text && s.text.map((t) => <p class="case-text muted t-body-20" set:html={t}></p>)}

      {s.blocks && s.blocks.map((b) => (
        <div class="case-block">
          <h3 class="case-subhead t-body-20">{b.head}</h3>
          <p class="case-text muted t-body-20">{b.text}</p>
        </div>
      ))}

      {s.leads && s.leads.map((l) => (
        <p class="case-text muted t-body-20"><span class="case-lead">{l.lead}.</span> {l.text}</p>
      ))}

      {s.facts && (
        <div class="case-facts t-body-20">
          {s.facts.map(([k, v]) => <p><span class="muted">{k}:</span> {v}</p>)}
        </div>
      )}

      {s.team && (
        <div class="case-team t-body-20">
          <p class="muted">Team:</p>
          {s.team.map((m) => <p>{m}</p>)}
        </div>
      )}

      {s.video && (
        <div slot="fig" class="case-video">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${s.video}`}
            title={`${data.title} video`}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      )}

      {s.band && (
        <div slot="fig" class="case-band" style={`background-image: url('${base}/cover.webp')`}>
          <img class="case-band-shot" src={`${base}/ui.webp`} alt={`${data.title} UI`} />
        </div>
      )}

      {s.figures && s.figures.map((f) => {
        // Jeden return na iterację (Fragment ze slot="fig") — inaczej kompilator slotów Astro się wywala.
        // W środku wybór: panel (grupa obrazków na tle) albo pojedynczy obrazek.
        const isPanel = typeof f === 'object' && f.images;
        const isRow = typeof f === 'object' && f.row;
        const src = typeof f === 'string' ? f : f.src;
        const join = typeof f === 'object' && f.join;
        const width = typeof f === 'object' && f.width;
        const widthMobile = typeof f === 'object' && f.widthMobile;
        const bleed = typeof f === 'object' && f.bleed;
        // width → zmienna CSS (nie inline szerokość), żeby dało się nadpisać na mobile.
        const imgCls = [join && 'fig-join', width && 'fig-w', bleed && 'fig-bleed'].filter(Boolean).join(' ') || undefined;
        const imgStyle = width ? `--fw:${width}${widthMobile ? `;--fw-m:${widthMobile}` : ''}` : undefined;
        // rząd: gap (obie osie) + opcjonalna szerokość całego rzędu (desktop; mobile wraca do 100%)
        const rowBg = typeof f === 'object' && f.bg;
        const rowCls = [`fig-row`, join && 'fig-join'].filter(Boolean).join(' ');
        const rowStyle = [
          f.gap && `--frow-gap:${f.gap}`,
          f.gapMobile && `--frow-gap-m:${f.gapMobile}`,
          width && `--frow-w:${width}`,
          widthMobile && `--frow-w-m:${widthMobile}`,
          rowBg && `--frow-bg:${rowBg}`,
        ].filter(Boolean).join(';') || undefined;
        return (
          <Fragment slot="fig">
            {isPanel
              ? <CasePanel bg={f.panel} width={f.width} widthMobile={f.widthMobile} padY={f.padY} padYMobile={f.padYMobile} gap={f.gap} images={f.images} base={base} alt={`${data.title} – ${s.label}`} />
              : isRow
              ? <div class={rowCls} style={rowStyle}>
                  {f.row.map((img) => (
                    <div class="fig-cell"><img src={`${base}/case/${img}`} alt={`${data.title} – ${s.label}`} /></div>
                  ))}
                </div>
              : <img class={imgCls} style={imgStyle} src={`${base}/case/${src}`} alt={`${data.title} – ${s.label}`} />}
          </Fragment>
        );
      })}
    </Section>
  ))}

  <!-- NEXT PROJECTS: tytuł dużym fontem (jak "Get in touch" w stopce) + 2 kafelki z work.js (rotacja po kole) -->
  <section class="case-next">
    <h2 class="t-display-55">Next projects</h2>
    <div class="grid">
      {nextTiles.map((item) => <Tile item={item} />)}
    </div>
  </section>
</Layout>

<style>
  /* hero case: headline u góry, meta na dole, obrazek lekko wystaje pod meta na starcie */
  .case-top { min-height: calc(86vh - var(--nav-h)); }
  .case-hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0;                  /* headline maksymalnie wysoko; odstęp do obrazka steruje .case-cover */
  }

  /* headline większy niż HP/About (HP = 4.78vw), płynny z oknem */
  .case-hero .hero-text { flex: 0 0 auto; }
  .case-hero .hero-text h1 {
    font-size: 9.5vw;
    line-height: 0.85;
    letter-spacing: -0.045em;
  }

  /* meta na dole: opis (40px) z lewej, rola w środku, rok z prawej; wyrównane do dołu */
  .case-meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-32);
  }
  .case-intro {                  /* typografia: t-display-40 */
    max-width: var(--intro-w, 620px);   /* 620 = domyślne (tuning Ania Kruk); hero.introWidth = override per-case */
  }
  .case-intro--nowrap {          /* krótszy intro: jedna linia na desktopie (bez limitu 620) */
    max-width: none;
    white-space: nowrap;
  }
  .case-role,
  .case-year {                   /* typografia: t-body-20 */
    white-space: nowrap;
  }

  /* hero image pełnej szerokości; odstęp od meta ("E-commerce platform...") = 40px */
  .case-cover { margin-top: var(--space-40); }
  .case-cover img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--fig-radius);
  }
  /* wariant z tłem: obrazek wyśrodkowany na aplu, 80% desktop / 100% mobile.
     padding góra/dół 0 = tło widać tylko po bokach (jak panele w tym case). */
  .case-cover--panel {
    padding: 0;
    display: flex;
    justify-content: center;
  }
  .case-cover--panel img { width: var(--cover-w, 80%); max-width: var(--cover-maxw, none); }

  /* treść Introduction: akapity (szare) + blok faktów (etykieta szara, wartość czarna) */
  .case-text + .case-text { margin-top: var(--space-24); }   /* odstęp między akapitami */
  .case-facts { margin-top: var(--space-48); }                /* odstęp akapity → fakty */
  /* Team: etykieta „Team:" (szara) w osobnej linii, pod nią nazwiska (czarne, stackowane).
     Przerwa fakty → Team jak w załączniku. */
  .case-team { margin-top: var(--space-40); }

  /* podblok (Project overview): czarny śródtytuł + szary akapit; odstęp między podblokami */
  .case-block + .case-block { margin-top: var(--space-48); }
  .case-subhead { color: var(--black); margin-bottom: var(--space-16); }   /* czarny, kontrast do szarej treści */

  /* lead-in inline (Key Challenges): tytuł czarny w jednym ciągu z szarym opisem (paragraf .muted) */
  .case-lead { color: var(--black); }

  /* wyróżnienie w akapicie: <strong> w treści case'a = czarny zamiast bolda (waga bez zmian).
     :global bo akapity idą przez set:html (dzieci nie dostają scope'a Astro) */
  .case-text :global(strong) { color: var(--black); font-weight: inherit; }

  /* WIDEO (YouTube embed, pełna szerokość, 16:9) w slocie fig */
  .case-video {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--fig-radius);
    overflow: hidden;
  }
  .case-video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* FULL-WIDTH BAND (figura Introduction): tło (cover, podciągnięte ~ -50 z Framera) + apla 0.6 + obiekt 80% wyśrodkowany.
     Obrazek tła wchodzi inline (per case) na .case-band; tu pozycja/skala/apla.
     Odstępy daje .section-fig (48 od tekstu) + dolny padding sekcji (200 do Project overview). */
  .case-band {
    position: relative;
    width: 100%;
    aspect-ratio: 1216 / 605;          /* obraz 1216×655 podciągnięty o ~50 = widoczne 605 */
    border-radius: var(--fig-radius);
    overflow: hidden;
    background-position: center 65%;    /* 65% ≈ podciągnięcie top -50 */
    background-size: cover;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .case-band::after {                   /* apla ściemniająca */
    content: "";
    position: absolute;
    inset: 0;
    background: var(--black);
    opacity: 0.6;
  }
  .case-band-shot {                     /* obiekt na wierzchu apli */
    position: relative;
    z-index: 1;
    width: 80%;
    height: auto;
    display: block;
  }

  /* NEXT PROJECTS: odstęp od ostatniej sekcji = rytm sekcji (200);
     dół jak HP (.work): 40 + padding-top stopki. Nagłówek/siatka/kafelki = style globalne. */
  /* linia + 40 do etykiety = rytm sekcji z linią (.section--line w global) */
  .case-next {
    margin-top: var(--space-200);
    padding: var(--space-40) 0 var(--space-40);
    border-top: 1px solid var(--gray-300);
  }
  /* etykieta (.section-label z global: kulka + wersaliki) stoi NAD siatką, nie w szynie */
  .case-next .grid { margin-top: var(--space-200); }

  @media (max-width: 800px) {
    /* hero dopasowany do wysokości ekranu (headline góra, meta dół); mniejszy vh niż desktop, żeby pierwszy obrazek wystawał */
    .case-top { min-height: calc(72vh - var(--nav-h)); }
    .case-hero { padding: 0; }
    .case-hero .hero-text h1 { font-size: 15.7vw; letter-spacing: -0.03em; }  /* najdłuższy wiersz ~344px na 390px (gutter 16) — prawie cała szerokość */
    /* gap meta→obrazek = gap obrazek→●Introduction = 32px */
    .case-cover { margin-top: var(--space-32); }
    .case-cover--panel { padding: 0; }
    .case-cover--panel img { width: 100%; }
    /* meta na mobile: tylko intro. Rola i rok ukryte — są w bloku faktów Introduction niżej (My role / Date) */
    .case-role,
    .case-year { display: none; }
    .case-intro { max-width: none; padding-right: var(--space-24); }   /* rozmiar 28px z t-display-40 (mobile); 24px oddechu od prawej */
    .case-intro--nowrap { white-space: normal; }   /* mobile: pozwól się zawijać (za wąsko na 1 linię) */
    /* Next projects: rytm sekcji mobile (96, jak dolny padding sekcji), etykieta → siatka jak tekst→figura */
    .case-next { margin-top: var(--space-96); padding-top: 20px; }   /* jak sekcje na mobile: linia → etykieta 20px */
    .case-next .grid { margin-top: var(--space-48); }
  }
</style>
