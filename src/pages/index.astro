---
// Strona główna: hero + sekcja "Selected work" (siatka kafelków z danych).
import Layout from '../layouts/Layout.astro';
import Tile from '../components/Tile.astro';
import { work } from '../data/work.js';
---

<Layout>
  <!-- TOP ZONE: hero ~80vh -->
  <div class="topzone">
    <section class="hero">
      <div class="hero-media">
        <div class="hero-stack">
          <img class="hero-shot" src="/assets/site/hero/hero-1.webp" alt="Selected project preview" />
          <img class="hero-shot" src="/assets/site/hero/hero-2.webp" alt="" aria-hidden="true" />
          <img class="hero-shot" src="/assets/site/hero/hero-3.webp" alt="" aria-hidden="true" />
          <img class="hero-shot" src="/assets/site/hero/hero-4.webp" alt="" aria-hidden="true" />
        </div>
      </div>
      <div class="hero-text">
        <h1>18+ years of experience creating websites, mobile apps, and digital products used by millions.</h1>
        <a href="mailto:arek.so@icloud.com" class="send">Send me a message</a>
      </div>
    </section>
  </div><!-- /topzone -->

  <!-- SELECTED WORK -->
  <section id="work" class="work">
    <div class="section-head reveal t-body-20">
      <h2 class="t-body-20">Selected work</h2>
      <span>(2016–2024)</span>
    </div>

    <div class="grid">
      {work.map((item) => <Tile item={item} />)}
    </div>
  </section>
</Layout>
