---
// Wspólny szkielet każdej strony: head (fonty, CSS), nav, stopka, menu mobilne, skrypt animacji.
// Treść strony wchodzi przez <slot/> (między nawigacją a stopką).
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MobileMenu from '../components/MobileMenu.astro';
import '../styles/global.css';

const {
  title = 'Arek Sobczyk – UX/UI Designer',
  description = 'Senior UX/UI Designer with 18+ years of experience creating websites, mobile apps, and digital products used by millions.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- favicon: czarny monogram na jasnym tabie, biały na ciemnym -->
    <link rel="icon" type="image/svg+xml" href="/favicon-light.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="wrap">
      <Nav />
      <slot />
      <Footer />
    </div>

    <MobileMenu />

    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
